<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- MAIN DASHBOARD (LANDSCAPE SPLIT VIEW) -->
    <LinearLayout
        android:id="@+id/dashboardLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- LEFT PANEL: LIVE CAMERA FEED & STATUS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="6dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="@color/card_dark"
                app:cardElevation="4dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.camera.view.PreviewView
                        android:id="@+id/previewView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/tvLiveStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="10dp"
                        android:background="#D9000000"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="● INITIALIZING CAMERA..."
                        android:textColor="@color/status_amber"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnFlipCamera"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="10dp"
                        android:backgroundTint="#D9000000"
                        android:text="🔄 Lens"
                        android:textColor="@color/text_white"
                        android:textSize="10sp"
                        android:textAllCaps="false"
                        android:paddingHorizontal="8dp" />

                    <TextView
                        android:id="@+id/tvCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="10dp"
                        android:background="#D9000000"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="Status: Ready"
                        android:textColor="@color/text_white"
                        android:textSize="12sp" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- EVENTS & STEALTH BUTTONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnOpenEvents"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="📊 Events Log"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    android:backgroundTint="@color/accent_blue"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnEnterStealth"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.3"
                    android:text="🌙 Stealth Mode"
                    android:textAllCaps="false"
                    android:textColor="@color/text_white"
                    android:backgroundTint="@color/card_dark"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- RIGHT PANEL: 5 SLOTS & CONTROLS -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:paddingStart="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    app:cardCornerRadius="10dp"
                    app:cardBackgroundColor="@color/card_dark">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Desk Sentry AI Master"
                                android:textColor="@color/accent_blue"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switchMasterSentry"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchAlwaysActive"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Always Monitor (Ignore Schedule &amp; Test Now)"
                            android:textColor="@color/status_amber"
                            android:textSize="12sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 5 CUSTOM STUDY SLOTS -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    app:cardCornerRadius="10dp"
                    app:cardBackgroundColor="@color/card_dark">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 Study Sessions (Custom Schedule)"
                            android:textColor="@color/accent_blue"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- SLOT 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">
                            <CheckBox
                                android:id="@+id/cbSlot1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />
                            <TextView
                                android:id="@+id/tvSlot1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Slot 1"
                                android:textColor="@color/text_white"
                                android:textSize="11sp" />
                            <Button
                                android:id="@+id/btnSetSlot1"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Set"
                                android:textSize="10sp"
                                android:textAllCaps="false"
                                android:paddingHorizontal="8dp" />
                        </LinearLayout>

                        <!-- SLOT 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginTop="2dp">
                            <CheckBox
                                android:id="@+id/cbSlot2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true" />
                            <TextView
                                android:id="@+id/tvSlot2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Slot 2"
                                android:textColor="@color/text_white"
                                android:textSize="11sp" />
                            <Button
                                android:id="@+id/btnSetSlot2"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Set"
                                android:textSize="10sp"
                                android:textAllCaps="false"
                                android:paddingHorizontal="8dp" />
                        </LinearLayout>

                        <!-- SLOT 3 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginTop="2dp">
                            <CheckBox
                                android:id="@+id/cbSlot3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false" />
                            <TextView
                                android:id="@+id/tvSlot3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Slot 3"
                                android:textColor="@color/text_white"
                                android:textSize="11sp" />
                            <Button
                                android:id="@+id/btnSetSlot3"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Set"
                                android:textSize="10sp"
                                android:textAllCaps="false"
                                android:paddingHorizontal="8dp" />
                        </LinearLayout>

                        <!-- SLOT 4 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginTop="2dp">
                            <CheckBox
                                android:id="@+id/cbSlot4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false" />
                            <TextView
                                android:id="@+id/tvSlot4"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Slot 4"
                                android:textColor="@color/text_white"
                                android:textSize="11sp" />
                            <Button
                                android:id="@+id/btnSetSlot4"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Set"
                                android:textSize="10sp"
                                android:textAllCaps="false"
                                android:paddingHorizontal="8dp" />
                        </LinearLayout>

                        <!-- SLOT 5 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginTop="2dp">
                            <CheckBox
                                android:id="@+id/cbSlot5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false" />
                            <TextView
                                android:id="@+id/tvSlot5"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Slot 5"
                                android:textColor="@color/text_white"
                                android:textSize="11sp" />
                            <Button
                                android:id="@+id/btnSetSlot5"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Set"
                                android:textSize="10sp"
                                android:textAllCaps="false"
                                android:paddingHorizontal="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- AWAY GRACE PERIOD -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    app:cardCornerRadius="10dp"
                    app:cardBackgroundColor="@color/card_dark">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Away Grace Period (Break Time)"
                            android:textColor="@color/accent_blue"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/rgGracePeriod"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                            <RadioButton
                                android:id="@+id/rb30s"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30s"
                                android:textColor="@color/text_white"
                                android:textSize="11sp" />

                            <RadioButton
                                android:id="@+id/rb1m"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 Min"
                                android:textColor="@color/text_white"
                                android:textSize="11sp" />

                            <RadioButton
                                android:id="@+id/rb3m"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="3 Min"
                                android:textColor="@color/text_white"
                                android:textSize="11sp" />

                            <RadioButton
                                android:id="@+id/rb5m"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5 Min"
                                android:textColor="@color/text_white"
                                android:textSize="11sp" />
                        </RadioGroup>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- SECURITY & TOOLS -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    app:cardCornerRadius="10dp"
                    app:cardBackgroundColor="@color/card_dark">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvAdminStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Anti-Uninstall: Inactive"
                                android:textColor="@color/status_red"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnActivateAdmin"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Enable Admin"
                                android:textSize="10sp"
                                android:textAllCaps="false"
                                android:paddingHorizontal="8dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp">

                            <Button
                                android:id="@+id/btnChangePin"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Change PIN"
                                android:textSize="11sp"
                                android:textAllCaps="false"
                                android:layout_marginEnd="4dp" />

                            <Button
                                android:id="@+id/btnTestAlarm"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Test Alarm"
                                android:textSize="11sp"
                                android:textAllCaps="false"
                                android:layout_marginStart="4dp"
                                android:backgroundTint="@color/status_amber" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- STEALTH OLED OVERLAY -->
    <LinearLayout
        android:id="@+id/stealthOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm a"
            android:format24Hour="HH:mm"
            android:textColor="#333333"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="● Desk Sentry Armed (OLED Power Saver)"
            android:textColor="#333333"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="[ Double Tap anywhere to Unlock / Stop Alarm ]"
            android:textColor="#222222"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
